/* Основные цвета */
:root {
    --primary: #e74c3c;  /* Красный */
    --secondary: #ffffff; /* Белый */
    --dark: #2c3e50;     /* Тёмный (почти чёрный) */
    --light-gray: #ecf0f1; /* Светло-серый */
    --accent: #c0392b;   /* Тёмно-красный */
}

/* Общие стили для всех окон */
QMainWindow, QDialog {
    background-color: var(--secondary);
    font-family: "Arial";
}

/* Заголовок окна */
QMainWindow::title {
    color: var(--dark);
    font-size: 16px;
    font-weight: bold;
    padding-left: 10px;
}

/* Групповые рамки (GroupBox) */
QGroupBox {
    border: 2px solid var(--primary);
    border-radius: 8px;
    margin-top: 10px;
    padding-top: 15px;
    font-weight: bold;
    color: var(--dark);
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
}

/* Кнопки */
QPushButton {
    background-color: var(--primary);
    color: var(--secondary);
    border: none;
    border-radius: 5px;
    padding: 8px 16px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: var(--accent);
}

QPushButton:pressed {
    background-color: var(--dark);
}

/* Текстовые поля (QLineEdit, QTextEdit) */
QLineEdit, QTextEdit, QComboBox, QSpinBox {
    border: 1px solid var(--primary);
    border-radius: 5px;
    padding: 5px;
    background: var(--secondary);
}

QLineEdit:focus, QTextEdit:focus {
    border: 2px solid var(--primary);
}

/* Список (QListWidget) */
QListWidget {
    border: 1px solid var(--primary);
    border-radius: 5px;
    background: var(--secondary);
    alternate-background-color: var(--light-gray);
}

QListWidget::item:hover {
    background: var(--light-gray);
}

/* Иконки кнопок (например, Like, Dislike) */
QPushButton[icon] {
    min-width: 32px;
    min-height: 32px;
    background: transparent;
    border: none;
}

/* QLabel (текстовые метки) */
QLabel {
    color: var(--dark);
    font-size: 14px;
}

/* Настройка скроллбаров */
QScrollBar:vertical {
    width: 10px;
    background: var(--light-gray);
}

QScrollBar::handle:vertical {
    background: var(--primary);
    min-height: 20px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    background: none;
}